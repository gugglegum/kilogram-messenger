; Kilogram deterministic-CBOR durable sync checkpoint, M1.1.13.

profile-version = 1
id-32 = bytes .size 32
signature-64 = bytes .size 64
canonical-bool = 0 / 1
optional-checkpoint-id = [] / [id-32]
sync-next-action-v1 = 1 / 2 / 3 / 4 / 5 / 6

sync-session-checkpoint-content-v1 = [
  profile-version,
  conversation-id: id-32,
  local-device-id: id-32,
  peer-device-id: id-32,
  session-binding: id-32,
  checkpoint-sequence: uint,
  sync-round: uint,
  predecessor-checkpoint-id: optional-checkpoint-id,
  received-event-ids: [* id-32],
  sent-event-ids: [* id-32],
  local-more-available: canonical-bool,
  peer-more-available: canonical-bool,
  next-action: sync-next-action-v1,
  paused: canonical-bool
]

signed-sync-session-checkpoint-v1 = [
  profile-version,
  sync-session-checkpoint-content-v1,
  signature-64
]

kilogram-sync-session-v1 = signed-sync-session-checkpoint-v1

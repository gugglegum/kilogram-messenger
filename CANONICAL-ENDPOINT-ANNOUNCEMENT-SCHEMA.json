    "root_rule": "kilogram-endpoint-announcement-plaintext-v1"
  },
  "activation": {
    "current_runtime_encoding": "postcard-v4-bundle-hpke-v1-envelope-ack-v2",
    "current_runtime_changed": false,
    "candidate_protocol_identifier": "unassigned",
    "required_before_activation": [

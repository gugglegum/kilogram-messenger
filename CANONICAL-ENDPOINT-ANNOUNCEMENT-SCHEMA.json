      "value": "kilogram:accepted-endpoint-observation-id:cbor-v1\\0",
      "operation": "blake3-domain-prefixed-digest"
    },
    {
      "id": "conversation-label-id-v1",
      "value": "kilogram:conversation-label:v1\\0",
      "operation": "blake3-domain-prefixed-digest",
      "compatibility": "reuses-active-conversation-identity-domain"

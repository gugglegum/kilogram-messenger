    {
      "id": "signed-endpoint-announcement-bundle-v1",
      "kind": "signed-envelope",
      "array_length": 3,
      "signature_domain": "endpoint-announcement-bundle-signature-v1"
    }
  ],
  "semantic_rules": [
    "the embedded Root-signed roster is verified and contains distinct source and recipient Devices",
    "contacts are strictly ordered by peer Account ID then derived conversation ID",
    "each contact has one to four Device-ID-ordered endpoints and exactly one primary endpoint",
    "conversation ID is the existing domain-separated hash of the exact non-empty UTF-8 label bytes",
    "direct and accepted observations match the candidate publication channel and peer identity",
    "accepted observation preserves the original observer signature and is re-signed by its importing Device",
    "conflict detector belongs to the exact embedded current roster",
    "Root resolution matches exact authority revision, peer, new write key, route policy and replacement ticket digest",
    "bundle source is the direct or accepting observation witness and signs the complete bounded plaintext",
    "bundle time window is positive, bounded and checked with a five-minute future skew allowance"
  ],
  "remaining": [
    "recipient-only-hpke-envelope",
    "session-bound-recipient-acknowledgement"
  ]
}

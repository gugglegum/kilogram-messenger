{
  "schema_version": 1,
  "milestone": "M1.1.54",
  "status": "history-compatible-frames-verified-session-and-capability-pending",
  "changes_active_wire": false,
  "profile": "kilogram-deterministic-cbor-v1",
  "cddl": {
    "standard": "RFC 8610",
    "path": "CANONICAL-SYNC-V2.cddl",
    "root_rule": "kilogram-sync-v2"
  },
  "activation": {
    "current_runtime_codec": "postcard-v6",
    "current_runtime_changed": false,
    "allocated_protocol_identifier": "kilogram/m1/sync/cbor/2",
    "registered_or_dialed": false,
    "advertised_by_authenticated_ticket": false,
    "required_before_activation": [
      "typed-durable-canonical-sync-session-checkpoint",
      "authenticated-sync-v2-ticket-capability",
      "dual-reader-and-downgrade-tests",
      "coverage-guided-fuzzing",
      "fresh-field-and-hosted-evidence"
    ]
  },
  "historical_active_event_compatibility": {
    "typed_identity": "namespace-and-event-id",
    "closed_carrier_schema": "CANONICAL-SYNC-HISTORY-V2-SCHEMA.json",
    "legacy_bridge_integrated": true,
    "native_canonical_event_integrated": true,
    "format_sniffing_or_fallback": false
  },
  "limits": {
    "maximum_inventory_event_keys": 4096,
    "maximum_events_per_batch": 64,
    "maximum_encoded_object_bytes": 8388608
  },
  "domains": [
    {
      "id": "sync-inventory-signature-v2",
      "value": "kilogram:sync-inventory-signature:cbor-v2\u0000",
      "operation": "ed25519-sign-domain-prefixed-content"
    },
    {
      "id": "sync-diff-signature-v2",
      "value": "kilogram:sync-diff-signature:cbor-v2\u0000",
      "operation": "ed25519-sign-domain-prefixed-content"
    }
  ],
  "external_objects": [
    {
      "id": "sync-event-key-v2-and-sync-event-carrier-v2",
      "schema": "CANONICAL-SYNC-HISTORY-V2-SCHEMA.json"
    }
  ],
  "objects": [
    { "id": "signed-sync-inventory-v2", "kind": "signed-envelope", "array_length": 3 },
    { "id": "sync-event-batch-v2", "kind": "client-payload", "array_length": 3 },
    { "id": "signed-sync-diff-v2", "kind": "signed-envelope", "array_length": 3 },
    { "id": "sync-complete-v2", "kind": "server-payload", "array_length": 4 },
    { "id": "sync-pause-v2", "kind": "client-payload", "array_length": 2 },
    { "id": "sync-paused-v2", "kind": "server-payload", "array_length": 2 },
    { "id": "sync-rejected-v2", "kind": "server-payload", "array_length": 3 },
    { "id": "sync-client-frame-v2", "kind": "closed-variant-frame", "array_length": 3 },
    { "id": "sync-server-frame-v2", "kind": "closed-variant-frame", "array_length": 3 }
  ],
  "variant_registry": {
    "client": {
      "1": "signed-sync-inventory-v2",
      "2": "sync-event-batch-v2",
      "3": "sync-pause-v2"
    },
    "server": {
      "1": "signed-sync-diff-v2",
      "2": "sync-complete-v2",
      "3": "sync-rejected-v2",
      "4": "sync-paused-v2"
    },
    "rejection_reason": {
      "1": "requester-not-allowed"
    }
  },
  "semantic_rules": [
    "all typed Event-key arrays are strictly ordered and duplicate-free",
    "closed Event carriers are verified and strictly ordered by their derived typed Event keys",
    "every nested Event carrier names the frame conversation",
    "inventory and diff signatures bind the authenticated Device identity and session binding",
    "boolean values are encoded only as unsigned integer zero or one",
    "closed variant registries reject unknown client server and rejection codes",
    "every standalone object and nested frame payload is bounded to eight MiB",
    "the decoder never sniffs or falls back between legacy Postcard and canonical CBOR events"
  ],
  "rust_bindings": [
    {
      "path": "crates/kilogram-protocol/src/canonical_sync_v2.rs",
      "symbol": "CANONICAL_SYNC_DIFF_SIGNATURE_DOMAIN_V2",
      "rust_type": "bytes",
      "value": "kilogram:sync-diff-signature:cbor-v2\u0000"
    }
  ]
}

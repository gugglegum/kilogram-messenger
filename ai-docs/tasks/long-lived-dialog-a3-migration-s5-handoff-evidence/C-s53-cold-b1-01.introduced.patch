+//! Fixed original lineage. These literals do not inspect/activate private data.
+use super::*;
+use kilogram_state::StateDirectoryLock;
+pub const WORKSPACE: &str = r"E:\AI-Projects\kilogram-p2p-messenger";
+pub const STATE: &str =

+#[derive(Clone, Debug)]
+pub(super) struct EventFields {
+    #[cfg(test)]
+    pub native_kind: u8,
+    pub scope: HistoryScope,
+    pub q: Id,
+    pub role: u8,
+    pub n: u64,
+    pub previous: Option<Id>,
+    pub sequence: u64,
+    pub kind: u8,
+    pub request: [u8; 16],
+    pub parents: Vec<Id>,
+    pub g: u64,
+    pub index: u64,
+    pub key: Id,
+    pub parent: Option<Id>,
+    pub tail: Option<Tail>,
+    pub author: Id,
+    pub id: Id,
+    pub core_offset: u16,
+    pub core_len: u16,
+}
+pub(super) fn read_event2(raw: &[u8]) -> Result<EventFields> {
+    let v = read(raw, 16 * 1024)?;
+    let f = v.fields(5)?;
+    yes(f[0].uint()? == 2, "Event2 version")?;
+    let c = f[1].fields(15)?;
+    yes(f[1].end - f[1].start <= 2048, "Core2 cap")?;
+    let h = f[2].fields(3)?;
+    f[4].fixed::<64>()?;
+    yes(
+        c[0].uint()? == 2
+            && c[5].uint()? <= 1
+            && (1..=3).contains(&c[9].uint()?)
+            && h[0].uint()? <= 1,
+        "Core/header fields",
+    )?;
+    yes(
+        !f[3].bytes()?.is_empty() && f[3].bytes()?.len() <= 12 * 1024,
+        "Olm cap",
+    )?;
+    let role = c[5].uint()? as u8;
+    let n = c[6].uint()?;
+    let kind = c[9].uint()? as u8;
+    let previous = c[7].id_opt()?;
+    let parents = c[11]
+        .list()?
+        .iter()
+        .map(Node::fixed)
+        .collect::<Result<Vec<Id>>>()?;
+    yes(
+        parents.len() <= 2 && parents.windows(2).all(|p| p[0] < p[1]),
+        "parents",
+    )?;
+    yes(
+        if n == 0 {
+            kind == role + 1 && previous.is_none() && parents.is_empty()
+        } else {
+            kind == 3 && previous.is_some()
+        },
+        "genesis shape",
+    )?;
+    yes(
+        n <= 1 || previous.is_some_and(|id| parents.contains(&id)),
+        "previous user parent",
+    )?;
+    let ex = c[12].fields(4)?;
+    let index = h[2].uint()?;
+    yes(
+        ex[1].uint()? == index && (kind == 1) == (h[0].uint()? == 0),
+        "outer header",
+    )?;
+    let tail = ex[3]
+        .optional()?
+        .map(|t| -> Result<Tail> {
+            let t = t.fields(4)?;
+            Ok(Tail {
+                g: t[0].uint()?,
+                key: t[1].fixed()?,
+                index: t[2].uint()?,
+                last: t[3].fixed()?,
+            })
+        })
+        .transpose()?;
+    Ok(EventFields {
+        #[cfg(test)]
+        native_kind: h[0].uint()? as u8,
+        scope: HistoryScope {
+            context: c[1].fixed()?,
+            dialog: c[2].fixed()?,
+            epoch: c[3].fixed()?,
+            session_id: c[4].sid()?,
+        },
+        q: c[14].fixed()?,
+        role,
+        n,
+        previous,
+        sequence: c[8].uint()?,
+        kind,
+        request: c[10].fixed()?,
+        parents,
+        g: ex[0].uint()?,
+        index,
+        key: h[1].fixed()?,
+        parent: ex[2].id_opt()?,
+        tail,
+        author: c[13].fixed()?,
+        id: hash_parts(b"kg:od2:event-id\0", &[raw]),
+        core_offset: u16::try_from(f[1].start).map_err(|_| Error::Bound("Core offset"))?,
+        core_len: u16::try_from(f[1].end - f[1].start).map_err(|_| Error::Bound("Core length"))?,
+    })
+}
+#[derive(Clone, Debug)]
+pub(super) struct ReceiptFields {
+    pub scope: HistoryScope,
+    pub q: Id,
+    pub format: u8,
+    pub role: u8,
+    pub n: u64,
+    pub event: Id,
+    pub cert: Id,

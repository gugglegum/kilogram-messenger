+fn a(items: impl IntoIterator<Item = Vec<u8>>) -> Vec<u8> {
+    let items = items.into_iter().collect::<Vec<_>>();
+    let mut v = head(4, items.len() as u64);
+    for item in items {
+        v.extend(item);
+    }
+    v
+}
+fn opt(id: Option<Id>) -> Vec<u8> {
+    a(id.map(b))
+}
+fn id(n: u64) -> Id {
+    hash_parts(b"S3 structural fixture\0", &[&n.to_be_bytes()])

+    request[8..].copy_from_slice(&n.to_be_bytes());
+    let mut parents = vec![
+        g.own().last.ok_or("own parent")?,
+        g.peer().last.ok_or("peer parent")?,
+    ];
+    parents.sort();
+    let core = wire::Core2 {
+        c: node.scope.context,
+        d: node.scope.dialog,

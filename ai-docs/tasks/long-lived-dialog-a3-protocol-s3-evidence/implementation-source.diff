+}
+pub(super) fn read_receipt2(raw: &[u8]) -> Result<ReceiptFields> {
+    let v = read(raw, 1024)?;
+    let f = v.fields(2)?;
+    let t = f[0].fields(12)?;
+    f[1].fixed::<64>()?;
+    yes(
+        t[0].uint()? == 2
+            && (1..=2).contains(&t[6].uint()?)
+            && t[7].uint()? <= 1
+            && t[8].uint()? > 0,
+        "receipt fields",
+    )?;
+    Ok(ReceiptFields {
+        scope: HistoryScope {
+            context: t[1].fixed()?,
+            dialog: t[2].fixed()?,
+            epoch: t[3].fixed()?,
+            session_id: t[4].sid()?,
+        },
+        q: t[5].fixed()?,
+        format: t[6].uint()? as u8,
+        role: t[7].uint()? as u8,
+        n: t[8].uint()?,
+        event: t[9].fixed()?,
+        cert: t[10].fixed()?,
+        auth: t[11].fixed()?,
+    })
+}
+#[derive(Clone, Debug)]
+pub(super) struct AuthFields {
+    pub id: Id,
+    pub cert: Id,
+}
+pub(super) fn read_auth_bundle(raw: &[u8]) -> Result<AuthFields> {
+    let v = read(raw, 16 * 1024)?;
+    let f = v.fields(3)?;
+    yes(f[0].uint()? == 1, "bundle version")?;
+    f[2].bytes()?;
+    Ok(AuthFields {
+        id: hash_parts(b"", &[raw]),
+        cert: hash_parts(b"", &[f[1].bytes()?]),
+    })
+}

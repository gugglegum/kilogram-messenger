+                timer.elapsed().as_secs_f64()
+            );
+        }
+    }
+    assert_eq!(p.records.len(), 642);
+    assert_eq!(p.calls(), 1284);
+    assert_eq!(p.nodes[0].native.guard.own().g, 1);
+    assert_eq!(p.nodes[1].native.guard.own().g, 0);

; Kilogram deterministic-CBOR local runtime IPC model, M1.1.49.
; Only unsigned integers, definite byte strings and definite arrays are used.

profile-version = 1
digest = bytes .size 32
token = bytes .size 32
account-id = bytes .size 32
device-id = bytes .size 32
instance-id = bytes .size 32
request-id = bytes .size 32
signature = bytes .size 64

runtime-ipc-loopback-address-v1 =
  [ipv4: 0, bytes .size 4] /
  [ipv6: 1, bytes .size 16]

runtime-ipc-descriptor-content-v1 = [
  profile-version,
  runtime-ipc-loopback-address-v1,
  port: 1..65535,
  bearer-token: token,
  account-id,
  device-id,
  server-instance-id: instance-id,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint
]

signed-runtime-ipc-descriptor-v1 = [
  profile-version,
  runtime-ipc-descriptor-content-v1,
  signature
]

runtime-ipc-core-command-v1 =
  [ping: 0] /
  [wait-for-change: 1, after-revision: uint, timeout-milliseconds: 1..120000] /
  [shutdown: 2]

runtime-ipc-core-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-core-command-v1
]

runtime-ipc-core-result-v1 =
  [pong: 0, account-id, device-id] /
  [change-state: 1, revision: uint, changed: 0..1] /
  [shutdown-accepted: 2] /
  [error: 3, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-core-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-core-result-v1
]

signed-runtime-ipc-core-response-v1 = [
  profile-version,
  runtime-ipc-core-response-content-v1,
  signature
]

runtime-ipc-option-uint-v1 = [none: 0] / [some: 1, uint]
runtime-ipc-option-bytes-v1 = [none: 0] / [some: 1, bytes]

runtime-ipc-conversation-cursor-v1 = [
  conversation-label-utf8: bytes .size (1..4096),
  peer-account-id: account-id
]

runtime-ipc-conversation-cursor-option-v1 =
  [none: 0] /
  [some: 1, runtime-ipc-conversation-cursor-v1]

runtime-ipc-history-cursor-v1 = [
  snapshot-id: digest,
  before-index: uint
]

runtime-ipc-history-cursor-option-v1 =
  [none: 0] /
  [some: 1, runtime-ipc-history-cursor-v1]

runtime-ipc-read-command-v1 =
  [conversation-list-page: 0, runtime-ipc-conversation-cursor-option-v1, limit: 1..64] /
  [history-page: 1, conversation-label-utf8: bytes .size (1..4096), runtime-ipc-history-cursor-option-v1, limit: 1..100] /
  [canonical-sync-v2-runtime-status: 2] /
  [peer-capability-quarantine-page: 3, runtime-ipc-option-digest-v1, limit: 1..64]

runtime-ipc-read-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-read-command-v1
]

runtime-ipc-route-policy-v1 = 0..2
runtime-ipc-endpoint-state-v1 = 0..2

runtime-ipc-endpoint-candidate-v1 = [
  peer-device-id: device-id,
  primary: 0..1,
  runtime-ipc-route-policy-v1,
  descriptor-path-utf8: bytes .size (1..4096),
  runtime-ipc-endpoint-state-v1,
  authority-revision: runtime-ipc-option-uint-v1,
  publication-channel-id-utf8: runtime-ipc-option-bytes-v1,
  observed-publication-generation: runtime-ipc-option-uint-v1,
  observed-at-unix-seconds: runtime-ipc-option-uint-v1,
  publication-conflict-generation: runtime-ipc-option-uint-v1,
  publication-conflict-proof-id-utf8: runtime-ipc-option-bytes-v1,
  publication-conflict-detected-at-unix-seconds: runtime-ipc-option-uint-v1,
  detail-utf8: bytes .size (1..4096)
]

runtime-ipc-message-preview-v1 = [
  event-id: digest,
  author-account-id: account-id,
  body-utf8: bytes .size (1..96),
  truncated: 0..1
]

runtime-ipc-message-preview-option-v1 =
  [none: 0] /
  [some: 1, runtime-ipc-message-preview-v1]

runtime-ipc-conversation-summary-v1 = [
  contact-id-utf8: bytes .size (1..4096),
  conversation-label-utf8: bytes .size (1..4096),
  conversation-id: digest,
  peer-account-id: account-id,
  peer-device-id: device-id,
  endpoint-candidate-count: 1..4,
  usable-endpoint-candidate-count: 0..4,
  stale-endpoint-candidate-count: 0..4,
  quarantined-endpoint-candidate-count: 0..4,
  endpoint-candidates: [1*4 runtime-ipc-endpoint-candidate-v1],
  runtime-ipc-route-policy-v1,
  message-count: uint,
  runtime-ipc-message-preview-option-v1
]

runtime-ipc-history-message-v1 = [
  event-id: digest,
  author-account-id: account-id,
  author-device-id: device-id,
  author-sequence: uint,
  body-utf8: bytes .size (1..196608)
]

runtime-ipc-history-page-v1 = [
  conversation-id: digest,
  snapshot-id: digest,
  total-messages: uint,
  messages: [* runtime-ipc-history-message-v1],
  runtime-ipc-history-cursor-option-v1
]

runtime-ipc-canonical-sync-v2-policy-source-v1 = 0..1
runtime-ipc-canonical-sync-v2-migration-state-v1 = 0..4
runtime-ipc-canonical-sync-v2-disposition-v1 = 0..1
runtime-ipc-canonical-sync-v2-permissions-v1 = [
  legacy-reader-enabled: 0..1,
  publish-canonical-capability: 0..1,
  register-canonical-alpn: 0..1,
  accept-new-canonical-session: 0..1,
  initiate-new-canonical-session: 0..1,
  resume-selected-canonical-session: 0..1
]
runtime-ipc-canonical-sync-v2-policy-snapshot-v1 = [
  runtime-ipc-canonical-sync-v2-policy-source-v1,
  record-id: runtime-ipc-option-digest-v1,
  runtime-ipc-canonical-sync-v2-migration-state-v1,
  runtime-ipc-canonical-sync-v2-disposition-v1,
  migration-epoch: uint,
  canonical-evidence-id: runtime-ipc-option-digest-v1,
  runtime-ipc-canonical-sync-v2-permissions-v1
]
runtime-ipc-sync-path-direction-v1 = 0..1
runtime-ipc-sync-path-protocol-v1 = 0..1
runtime-ipc-sync-path-outcome-v1 = 0..3
runtime-ipc-option-device-id-v1 = [none: 0] / [some: 1, device-id]
runtime-ipc-option-conversation-id-v1 = [none: 0] / [some: 1, digest]
runtime-ipc-sync-path-observation-v1 = [
  sequence: 1..18446744073709551615,
  runtime-ipc-sync-path-direction-v1,
  runtime-ipc-sync-path-protocol-v1,
  runtime-ipc-sync-path-outcome-v1,
  peer-endpoint-id: digest,
  peer-device-id: runtime-ipc-option-device-id-v1,
  conversation-id: runtime-ipc-option-conversation-id-v1,
  selection-id: runtime-ipc-option-digest-v1
]
runtime-ipc-canonical-sync-v2-runtime-status-v1 = [
  loaded: runtime-ipc-canonical-sync-v2-policy-snapshot-v1,
  configured: runtime-ipc-canonical-sync-v2-policy-snapshot-v1,
  configured-matches-loaded: 0..1,
  restart-required: 0..1,
  observation-capacity: 32,
  observations: [*32 runtime-ipc-sync-path-observation-v1]
]

runtime-ipc-peer-capability-quarantine-reason-v1 = 0..4
runtime-ipc-peer-capability-status-item-v1 = [
  opaque-contact-id: digest,
  durable-quarantined-candidate-count: 0..4,
  durable-reasons: [*5 runtime-ipc-peer-capability-quarantine-reason-v1],
  scheduler-sync-suppressed: 0..1,
  scheduler-queue-suppressed-count: 0..4096,
  network-retry-queue-count: 0..4096,
  pending-queue-count: 0..4096
]
runtime-ipc-peer-capability-page-v1 = [
  capability-store-initialized: 0..1,
  total-relevant-contact-count: 0..256,
  durable-quarantined-contact-count: 0..256,
  scheduler-suppressed-contact-count: 0..256,
  scheduler-suppressed-queue-count: 0..4096,
  network-retry-contact-count: 0..256,
  network-retry-queue-count: 0..4096,
  items: [*64 runtime-ipc-peer-capability-status-item-v1],
  next-cursor: runtime-ipc-option-digest-v1
]

runtime-ipc-read-result-v1 =
  [conversation-list-page: 0, conversations: [* runtime-ipc-conversation-summary-v1], runtime-ipc-conversation-cursor-option-v1] /
  [history-page: 1, runtime-ipc-history-page-v1] /
  [canonical-sync-v2-runtime-status-result: 2, runtime-ipc-canonical-sync-v2-runtime-status-v1] /
  [peer-capability-quarantine-page-result: 3, runtime-ipc-peer-capability-page-v1] /
  [error: 4, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-read-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-read-result-v1
]

signed-runtime-ipc-read-response-v1 = [
  profile-version,
  runtime-ipc-read-response-content-v1,
  signature
]

runtime-ipc-option-digest-v1 = [none: 0] / [some: 1, digest]

runtime-ipc-contact-command-v1 =
  [add-contact: 0, conversation-label-utf8: bytes .size (1..4096), expected-peer-account-id: account-id, peer-endpoint-descriptor-path-utf8: bytes .size (1..4096)] /
  [own-device-directory-status: 1]

runtime-ipc-contact-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-contact-command-v1
]

runtime-ipc-profile-convergence-v1 =
  current: 0 /
  required: 1

runtime-ipc-restart-recovery-v1 =
  authenticated-receipt-current: 0 /
  authenticated-receipt-recovered: 1 /
  launch-profile-recovered: 2

runtime-ipc-own-device-directory-status-v1 = [
  profile-version,
  account-id,
  device-id,
  state-directory-path-utf8: bytes .size (1..4096),
  authority-revision: 1..18446744073709551615,
  active-device-count: 1..32,
  applied-receipt-id: runtime-ipc-option-digest-v1,
  applied-receipt-generation: runtime-ipc-option-uint-v1,
  device-list-digest: digest,
  applied-device-list-file-utf8: bytes .size (1..4096),
  launch-device-list-file-utf8: bytes .size (1..4096),
  runtime-ipc-profile-convergence-v1,
  runtime-ipc-restart-recovery-v1
]

runtime-ipc-contact-result-v1 =
  [contact-added: 0, contact-id: digest, peer-account-id: account-id, peer-device-id: device-id, endpoint-candidate-count: 1..4, endpoint-candidate-added: 0..1, inserted: 0..1] /
  [own-device-directory-status: 1, runtime-ipc-own-device-directory-status-v1] /
  [error: 2, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-contact-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-contact-result-v1
]

signed-runtime-ipc-contact-response-v1 = [
  profile-version,
  runtime-ipc-contact-response-content-v1,
  signature
]

runtime-ipc-directory-command-v1 =
  [apply-own-device-directory: 0,
   device-list-file-utf8: bytes .size (1..4096),
   expected-current-authority-revision: 1..18446744073709551615,
   expected-current-device-list-digest: digest,
   candidate-signed-account-device-list-cbor: bytes .size (1..65536)]

runtime-ipc-directory-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-directory-command-v1
]

runtime-ipc-future-recipient-status-v1 =
  removed-devices-excluded-from-future-recipient-sets: 0

runtime-ipc-preexisting-recipient-status-v1 =
  immutable-cannot-be-remotely-rewritten-or-erased: 0

runtime-ipc-history-availability-status-v1 =
  existing-copies-remain-readable: 0

runtime-ipc-device-directory-applied-v1 = [
  profile-version,
  account-id,
  device-id,
  previous-authority-revision: 1..18446744073709551615,
  authority-revision: 1..18446744073709551615,
  previous-device-list-digest: digest,
  device-list-digest: digest,
  active-device-count: 1..32,
  removed-device-ids: [*32 device-id],
  ratchet-session-records-retired: uint,
  prekey-observations-retired: uint,
  pending-unmaterialized-messages: uint,
  pending-materialized-messages: uint,
  ticket-published: 0..1,
  launch-profile-update-required: 0..1,
  runtime-ipc-future-recipient-status-v1,
  runtime-ipc-preexisting-recipient-status-v1,
  runtime-ipc-history-availability-status-v1,
  runtime-ipc-own-device-directory-status-v1
]

runtime-ipc-directory-result-v1 =
  [own-device-directory-applied: 0, runtime-ipc-device-directory-applied-v1] /
  [error: 1, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-directory-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-directory-result-v1
]

signed-runtime-ipc-directory-response-v1 = [
  profile-version,
  runtime-ipc-directory-response-content-v1,
  signature
]

runtime-ipc-queue-command-v1 =
  [queue-message: 0,
   conversation-label-utf8: bytes .size (1..4096),
   peer-account-id: account-id,
   message-utf8: bytes .size (1..65536)]

runtime-ipc-queue-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-queue-command-v1
]

runtime-ipc-queue-result-v1 =
  [message-queued: 0,
   queue-id: digest,
   contact-id: digest,
   conversation-id: digest,
   peer-account-id: account-id,
   inserted: 0..1] /
  [error: 1, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-queue-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-queue-result-v1
]

signed-runtime-ipc-queue-response-v1 = [
  profile-version,
  runtime-ipc-queue-response-content-v1,
  signature
]

runtime-ipc-outbox-cursor-v1 = [
  snapshot-id: digest,
  start-index: uint
]

runtime-ipc-outbox-cursor-option-v1 =
  [none: 0] /
  [some: 1, runtime-ipc-outbox-cursor-v1]

runtime-ipc-outbox-command-v1 =
  [outbox-status-page: 0, runtime-ipc-outbox-cursor-option-v1, limit: 1..128]

runtime-ipc-outbox-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-outbox-command-v1
]

runtime-ipc-outbox-state-v1 = 0..6

runtime-ipc-outbox-counts-v1 = [
  contact-count: 0..256,
  queue-count: 0..4096,
  pending-count: 0..4096,
  materialized-count: 0..4096,
  delivered-count: 0..4096,
  mailbox-pending-count: 0..4096,
  mailbox-stored-count: 0..4096,
  mailbox-expired-count: 0..4096,
  mailbox-failed-count: 0..4096,
  retry-record-count: 0..4096
]

runtime-ipc-outbox-item-v1 = [
  queue-id: digest,
  contact-id: digest,
  peer-account-id: account-id,
  conversation-id: digest,
  runtime-ipc-outbox-state-v1,
  acknowledgement-event-id: runtime-ipc-option-digest-v1,
  retry-record-count: 0..4096
]

runtime-ipc-outbox-page-v1 = [
  snapshot-id: digest,
  runtime-ipc-outbox-counts-v1,
  items: [*128 runtime-ipc-outbox-item-v1],
  runtime-ipc-outbox-cursor-option-v1
]

runtime-ipc-outbox-result-v1 =
  [outbox-status-page: 0, runtime-ipc-outbox-page-v1] /
  [error: 1, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-outbox-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-outbox-result-v1
]

signed-runtime-ipc-outbox-response-v1 = [
  profile-version,
  runtime-ipc-outbox-response-content-v1,
  signature
]

; The nested signed storage offer uses signed-mailbox-storage-offer-v1 from
; CANONICAL-MAILBOX.cddl and is transported as its exact canonical CBOR bytes.
runtime-ipc-provider-command-v1 =
  [import-volunteer-storage-offer: 0, signed-storage-offer-cbor: bytes .size (1..24576)] /
  [select-volunteer-storage-providers: 1, selection-salt: digest, requested: 1..8]

runtime-ipc-provider-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-provider-command-v1
]

runtime-ipc-provider-import-outcome-v1 = 0..2

runtime-ipc-volunteer-provider-v1 = [
  signed-storage-offer-cbor: bytes .size (1..24576),
  transport-identity: digest,
  observed-at-unix-seconds: uint
]

runtime-ipc-provider-result-v1 =
  [volunteer-storage-offer-imported: 0,
    runtime-ipc-provider-import-outcome-v1,
    active-provider-count: 1..4096,
    runtime-ipc-volunteer-provider-v1] /
  [volunteer-storage-providers-selected: 1,
    selection-salt: digest,
    requested: 1..8,
    active-provider-count: 0..4096,
    providers: [*8 runtime-ipc-volunteer-provider-v1]] /
  [error: 2, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-provider-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-provider-result-v1
]

signed-runtime-ipc-provider-response-v1 = [
  profile-version,
  runtime-ipc-provider-response-content-v1,
  signature
]

runtime-ipc-mailbox-status-cursor-v1 = [
  profile-version,
  snapshot-id: digest,
  start-index: uint
]

runtime-ipc-mailbox-status-cursor-option-v1 =
  [none: 0] /
  [some: 1, runtime-ipc-mailbox-status-cursor-v1]

runtime-ipc-mailbox-status-command-v1 =
  [mailbox-capability-status-page: 0,
   runtime-ipc-mailbox-status-cursor-option-v1,
   limit: 1..16]

runtime-ipc-mailbox-status-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-mailbox-status-command-v1
]

; Nested update and acknowledgement values are the exact canonical CBOR bytes
; defined by CANONICAL-MAILBOX-PROVISIONING.cddl. They contain only signed
; update state and a sealed peer offer, never the local read/write secrets.
runtime-ipc-mailbox-capability-head-v1 = [
  profile-version,
  signed-mailbox-capability-update-cbor: bytes .size (1..32768),
  acknowledgement: runtime-ipc-mailbox-acknowledgement-option-v1
]

runtime-ipc-mailbox-acknowledgement-option-v1 =
  [none: 0] /
  [some: 1, signed-mailbox-capability-acknowledgement-cbor: bytes .size (1..4096)]

runtime-ipc-mailbox-status-counts-v1 = [
  profile-version,
  head-count: 0..1024,
  active-head-count: 0..1024,
  revoked-head-count: 0..1024,
  acknowledged-head-count: 0..1024,
  unacknowledged-head-count: 0..1024,
  local-owner-head-count: 0..1024,
  local-recipient-head-count: 0..1024
]

runtime-ipc-mailbox-status-page-v1 = [
  profile-version,
  snapshot-id: digest,
  runtime-ipc-mailbox-status-counts-v1,
  heads: [*16 runtime-ipc-mailbox-capability-head-v1],
  runtime-ipc-mailbox-status-cursor-option-v1
]

runtime-ipc-mailbox-status-result-v1 =
  [mailbox-capability-status-page: 0, runtime-ipc-mailbox-status-page-v1] /
  [error: 1, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-mailbox-status-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-mailbox-status-result-v1
]

signed-runtime-ipc-mailbox-status-response-v1 = [
  profile-version,
  runtime-ipc-mailbox-status-response-content-v1,
  signature
]

runtime-ipc-mailbox-mutation-target-v1 = [
  profile-version,
  contact-id: digest,
  recipient-account-id: account-id,
  recipient-device-id: device-id,
  recipient-device-list-digest: digest,
  scope: digest
]

; The provider selection and predecessor head are exact signed canonical
; objects. No local binding or plaintext mailbox secret crosses this boundary.
runtime-ipc-mailbox-mutation-command-v1 =
  [create-mailbox-capability: 0,
   runtime-ipc-mailbox-mutation-target-v1,
   signed-provider-selection-cbor: bytes .size (1..262144),
   offer-valid-for-seconds: 60..2592000] /
  [rotate-mailbox-capability: 1,
   runtime-ipc-mailbox-mutation-target-v1,
   runtime-ipc-mailbox-capability-head-v1,
   signed-provider-selection-cbor: bytes .size (1..262144),
   offer-valid-for-seconds: 60..2592000] /
  [revoke-mailbox-capability: 2,
   runtime-ipc-mailbox-mutation-target-v1,
   runtime-ipc-mailbox-capability-head-v1]

runtime-ipc-mailbox-mutation-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-mailbox-mutation-command-v1
]


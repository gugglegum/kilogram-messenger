; Kilogram deterministic-CBOR local runtime IPC core and read model, M1.1.29.
; Only unsigned integers, definite byte strings and definite arrays are used.

profile-version = 1
digest = bytes .size 32
token = bytes .size 32
account-id = bytes .size 32
device-id = bytes .size 32
instance-id = bytes .size 32
request-id = bytes .size 32
signature = bytes .size 64

runtime-ipc-loopback-address-v1 =
  [ipv4: 0, bytes .size 4] /
  [ipv6: 1, bytes .size 16]

runtime-ipc-descriptor-content-v1 = [
  profile-version,
  runtime-ipc-loopback-address-v1,
  port: 1..65535,
  bearer-token: token,
  account-id,
  device-id,
  server-instance-id: instance-id,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint
]

signed-runtime-ipc-descriptor-v1 = [
  profile-version,
  runtime-ipc-descriptor-content-v1,
  signature
]

runtime-ipc-core-command-v1 =
  [ping: 0] /
  [wait-for-change: 1, after-revision: uint, timeout-milliseconds: 1..120000] /
  [shutdown: 2]

runtime-ipc-core-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-core-command-v1
]

runtime-ipc-core-result-v1 =
  [pong: 0, account-id, device-id] /
  [change-state: 1, revision: uint, changed: 0..1] /
  [shutdown-accepted: 2] /
  [error: 3, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-core-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-core-result-v1
]

signed-runtime-ipc-core-response-v1 = [
  profile-version,
  runtime-ipc-core-response-content-v1,
  signature
]

runtime-ipc-option-uint-v1 = [none: 0] / [some: 1, uint]
runtime-ipc-option-bytes-v1 = [none: 0] / [some: 1, bytes]

runtime-ipc-conversation-cursor-v1 = [
  conversation-label-utf8: bytes .size (1..4096),
  peer-account-id: account-id
]

runtime-ipc-conversation-cursor-option-v1 =
  [none: 0] /
  [some: 1, runtime-ipc-conversation-cursor-v1]

runtime-ipc-history-cursor-v1 = [
  snapshot-id: digest,
  before-index: uint
]

runtime-ipc-history-cursor-option-v1 =
  [none: 0] /
  [some: 1, runtime-ipc-history-cursor-v1]

runtime-ipc-read-command-v1 =
  [conversation-list-page: 0, runtime-ipc-conversation-cursor-option-v1, limit: 1..64] /
  [history-page: 1, conversation-label-utf8: bytes .size (1..4096), runtime-ipc-history-cursor-option-v1, limit: 1..100]

runtime-ipc-read-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-read-command-v1
]

runtime-ipc-route-policy-v1 = 0..2
runtime-ipc-endpoint-state-v1 = 0..2

runtime-ipc-endpoint-candidate-v1 = [
  peer-device-id: device-id,
  primary: 0..1,
  runtime-ipc-route-policy-v1,
  descriptor-path-utf8: bytes .size (1..4096),
  runtime-ipc-endpoint-state-v1,
  authority-revision: runtime-ipc-option-uint-v1,
  publication-channel-id-utf8: runtime-ipc-option-bytes-v1,
  observed-publication-generation: runtime-ipc-option-uint-v1,
  observed-at-unix-seconds: runtime-ipc-option-uint-v1,
  publication-conflict-generation: runtime-ipc-option-uint-v1,
  publication-conflict-proof-id-utf8: runtime-ipc-option-bytes-v1,
  publication-conflict-detected-at-unix-seconds: runtime-ipc-option-uint-v1,
  detail-utf8: bytes .size (1..4096)
]

runtime-ipc-message-preview-v1 = [
  event-id: digest,
  author-account-id: account-id,
  body-utf8: bytes .size (1..96),
  truncated: 0..1
]

runtime-ipc-message-preview-option-v1 =
  [none: 0] /
  [some: 1, runtime-ipc-message-preview-v1]

runtime-ipc-conversation-summary-v1 = [
  contact-id-utf8: bytes .size (1..4096),
  conversation-label-utf8: bytes .size (1..4096),
  conversation-id: digest,
  peer-account-id: account-id,
  peer-device-id: device-id,
  endpoint-candidate-count: 1..4,
  usable-endpoint-candidate-count: 0..4,
  stale-endpoint-candidate-count: 0..4,
  quarantined-endpoint-candidate-count: 0..4,
  endpoint-candidates: [1*4 runtime-ipc-endpoint-candidate-v1],
  runtime-ipc-route-policy-v1,
  message-count: uint,
  runtime-ipc-message-preview-option-v1
]

runtime-ipc-history-message-v1 = [
  event-id: digest,
  author-account-id: account-id,
  author-device-id: device-id,
  author-sequence: uint,
  body-utf8: bytes .size (1..196608)
]

runtime-ipc-history-page-v1 = [
  conversation-id: digest,
  snapshot-id: digest,
  total-messages: uint,
  messages: [* runtime-ipc-history-message-v1],
  runtime-ipc-history-cursor-option-v1
]

runtime-ipc-read-result-v1 =
  [conversation-list-page: 0, conversations: [* runtime-ipc-conversation-summary-v1], runtime-ipc-conversation-cursor-option-v1] /
  [history-page: 1, runtime-ipc-history-page-v1] /
  [error: 2, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-read-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-read-result-v1
]

signed-runtime-ipc-read-response-v1 = [
  profile-version,
  runtime-ipc-read-response-content-v1,
  signature
]

kilogram-runtime-ipc-v1 =
  signed-runtime-ipc-descriptor-v1 /
  runtime-ipc-core-request-v1 /
  signed-runtime-ipc-core-response-v1 /
  runtime-ipc-read-request-v1 /
  signed-runtime-ipc-read-response-v1

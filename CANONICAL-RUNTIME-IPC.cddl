runtime-ipc-own-device-roster-child-status-v1 = [
  profile-version,
  runtime-ipc-own-device-roster-child-lifecycle-v1,
  discovery-policy-status-cbor: bytes .size (1..524288)
]

runtime-ipc-own-device-roster-command-v1 =
  [configure-own-device-roster-automation: 0,
   current-device-list-cbor: bytes .size (1..524288),
   runtime-ipc-own-device-roster-previous-policy-v1,
   runtime-ipc-own-device-roster-configuration-v1] /
  [own-device-roster-automation-status: 1,
   current-device-list-cbor: bytes .size (1..524288)]

runtime-ipc-own-device-roster-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-own-device-roster-command-v1
]

runtime-ipc-own-device-roster-result-v1 =
  [own-device-roster-automation-configured: 0,
   outcome: 0..1,
   authority-revision: uint,
   device-list-digest: digest,
   current-network: runtime-ipc-own-device-discovery-network-v1,
   runtime-ipc-own-device-roster-policy-status-v1,
   snapshot-id: digest,
   children: [* runtime-ipc-own-device-roster-child-status-v1],
   active-children: 0..64,
   retired-children: 0..64,
   maximum-parallel-workflows: 1,
   restart-not-required: 0,
   foreground-runtime-only: 0,
   os-background-service-enabled: 0] /
  [own-device-roster-automation-status: 1,
   authority-revision: uint,
   device-list-digest: digest,
   current-network: runtime-ipc-own-device-discovery-network-v1,
   runtime-ipc-own-device-roster-policy-status-v1,
   snapshot-id: digest,
   children: [* runtime-ipc-own-device-roster-child-status-v1],
   active-children: 0..64,
   retired-children: 0..64,
   maximum-parallel-workflows: 1,
   foreground-runtime-only: 0,
   os-background-service-enabled: 0] /
  [error: 2, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-own-device-roster-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-own-device-roster-result-v1
]

signed-runtime-ipc-own-device-roster-response-v1 = [
  profile-version,
  runtime-ipc-own-device-roster-response-content-v1,
  signature
]

; Custody is deliberately separate from history recovery execution. The
; embedded link and plan are independently verified canonical CBOR artifacts;
; neither private capabilities nor history payload cross this IPC surface.
runtime-ipc-recovery-execution-policy-v1 = [
  profile-version,
  allow-ethernet: 0..1,
  allow-wifi: 0..1,
  allow-mobile: 0..1,
  allow-unknown-network: 0..1,
  require-external-power: 0..1
]

runtime-ipc-recovery-plan-command-v1 =
  [approve-history-recovery-plan: 0,
   signed-recovery-link-cbor: bytes .size (1..1048576),
   confirmed-sas: digest,
   runtime-ipc-recovery-execution-policy-v1,
   valid-for-seconds: 3600..604800] /
  [history-recovery-plan-status: 1, plan-id: digest] /
  [cancel-history-recovery-plan: 2, plan-id: digest, expected-record-id: digest]

runtime-ipc-recovery-plan-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-recovery-plan-command-v1
]

runtime-ipc-recovery-plan-cancellation-content-v1 = [
  profile-version,
  plan-id: digest,
  account-id,
  recipient-device-id: device-id,
  cancelled-at-unix-seconds: uint,
  user-requested: 0
]

signed-runtime-ipc-recovery-plan-cancellation-v1 = [
  profile-version,
  runtime-ipc-recovery-plan-cancellation-content-v1,
  signature
]

runtime-ipc-recovery-plan-cancellation-option-v1 =
  [none: 0] /
  [some: 1, cancellation-cbor: bytes .size (1..1024)]

runtime-ipc-recovery-plan-state-v1 = [
  profile-version,
  record-id: digest,
  lifecycle: 0..1,
  signed-recovery-plan-cbor: bytes .size (1..1048576),
  runtime-ipc-recovery-plan-cancellation-option-v1
]

runtime-ipc-recovery-plan-custody-v1 = [
  profile-version,
  runtime-ipc-recovery-plan-state-v1,
  restart-not-required: 0,
  foreground-runtime-only: 0,
  os-background-service-enabled: 0
]

runtime-ipc-recovery-plan-result-v1 =
  [history-recovery-plan-approved: 0,
   outcome: 0..1,
   runtime-ipc-recovery-plan-custody-v1] /
  [history-recovery-plan-status: 1,
   runtime-ipc-recovery-plan-custody-v1] /
  [history-recovery-plan-cancelled: 2,
   outcome: 0..1,
   runtime-ipc-recovery-plan-custody-v1] /
  [error: 3, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-recovery-plan-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-recovery-plan-result-v1
]

signed-runtime-ipc-recovery-plan-response-v1 = [
  profile-version,
  runtime-ipc-recovery-plan-response-content-v1,
  signature
]

; Execution consumes an already approved recovery-plan record. The routine
; caller may start or inspect it, but only the recipient Device can append the
; signed scheduler chain and canonical recovery checkpoints.
runtime-ipc-recovery-execution-command-v1 =
  [start-history-recovery-execution: 0,
   plan-id: digest,
   expected-plan-record-id: digest,
   retry-base-seconds: 1..300,
   retry-max-seconds: 1..3600,
   attempt-lease-seconds: 30..7200] /
  [history-recovery-execution-status: 1, plan-id: digest]

runtime-ipc-recovery-execution-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-recovery-execution-command-v1
]

runtime-ipc-recovery-scheduler-optional-id-v1 =
  [none: 0] /
  [some: 1, value: digest]

runtime-ipc-recovery-scheduler-optional-failure-v1 =
  [none: 0] /
  [some: 1, failure-code: 1..65535]

runtime-ipc-recovery-scheduler-transition-v1 = 0..5
runtime-ipc-recovery-scheduler-lifecycle-v1 = 0..3

runtime-ipc-recovery-scheduler-state-content-v1 = [
  profile-version,
  plan-id: digest,
  recipient-device-id: device-id,
  generation: uint,
  previous-state-id: runtime-ipc-recovery-scheduler-optional-id-v1,
  runtime-ipc-recovery-scheduler-transition-v1,
  runtime-ipc-recovery-scheduler-lifecycle-v1,
  total-attempts: uint,
  consecutive-failures: 0..4294967295,
  last-observed-unix-seconds: uint,
  next-attempt-at-unix-seconds: uint,
  scheduled-delay-seconds: 0..7200,
  retry-base-seconds: 1..300,
  retry-max-seconds: 1..3600,
  attempt-lease-seconds: 30..7200,
  latest-checkpoint-cbor: bytes .size (1..524288),
  runtime-ipc-recovery-scheduler-optional-failure-v1
]

signed-runtime-ipc-recovery-scheduler-state-v1 = [
  profile-version,
  runtime-ipc-recovery-scheduler-state-content-v1,
  signature
]

runtime-ipc-recovery-network-v1 = 0..3
runtime-ipc-recovery-power-v1 = 0..2

runtime-ipc-recovery-readiness-v1 =
  [ready: 0] /
  [deferred: 1, not-before-unix-seconds: uint] /
  [blocked-network: 2] /
  [blocked-power: 3] /
  [attempting: 4, lease-expires-at-unix-seconds: uint] /
  [attempt-lease-expired: 5] /
  [clock-rollback: 6, last-observed-unix-seconds: uint] /
  [plan-expired: 7] /
  [cancelled: 8] /
  [completed: 9]

runtime-ipc-recovery-execution-snapshot-v1 = [
  profile-version,
  recovery-plan-state-cbor: bytes .size (1..2097152),
  recovery-scheduler-state-cbor: bytes .size (1..524288),
  observed-at-unix-seconds: uint,
  runtime-ipc-recovery-network-v1,
  runtime-ipc-recovery-power-v1,
  runtime-ipc-recovery-readiness-v1,
  restart-not-required: 0,
  foreground-runtime-only: 0,
  os-background-service-enabled: 0
]

runtime-ipc-recovery-execution-result-v1 =
  [history-recovery-execution-started: 0,
   outcome: 0..1,
   runtime-ipc-recovery-execution-snapshot-v1] /
  [history-recovery-execution-status: 1,
   runtime-ipc-recovery-execution-snapshot-v1] /
  [error: 2, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-recovery-execution-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-recovery-execution-result-v1
]

signed-runtime-ipc-recovery-execution-response-v1 = [
  profile-version,
  runtime-ipc-recovery-execution-response-content-v1,
  signature
]

; Per-contact publish/refresh automation is a foreground-runtime scheduler.
; It persists signed policy and attempt state but neither installs an OS
; background service nor stores ticket plaintext in routine IPC.
runtime-ipc-ticket-automation-previous-policy-v1 =
  [none: 0] /
  [some: 1, generation: uint, policy-id: digest]

runtime-ipc-ticket-automation-configuration-v1 = [
  profile-version,
  contact-id: digest,
  conversation-label-utf8: bytes .size (1..4096),
  peer-account-id: account-id,
  enabled: 0..1,
  service-origin-utf8: bytes .size (1..512),
  ttl-seconds: 30..3600,
  refresh-before-seconds: 10..1800,
  retry-base-seconds: 1..3600,
  retry-max-seconds: 1..3600,
  allowed-network-mask: 0..15
]

runtime-ipc-ticket-automation-command-v1 =
  [configure-ticket-automation: 0,
   runtime-ipc-ticket-automation-previous-policy-v1,
   runtime-ipc-ticket-automation-configuration-v1] /
  [ticket-automation-status: 1]

runtime-ipc-ticket-automation-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-ticket-automation-command-v1
]

runtime-ipc-ticket-automation-optional-id-v1 =
  [none: 0] /
  [some: 1, value: digest]

runtime-ipc-ticket-automation-optional-uint-v1 =
  [none: 0] /
  [some: 1, value: uint]

runtime-ipc-ticket-automation-network-v1 = 0..3
runtime-ipc-ticket-automation-action-v1 = 0..1
runtime-ipc-ticket-automation-scheduler-state-v1 = 0..5
runtime-ipc-ticket-automation-last-result-v1 = 0..2

runtime-ipc-ticket-automation-action-status-v1 = [
  profile-version,
  runtime-ipc-ticket-automation-action-v1,
  runtime-ipc-ticket-automation-scheduler-state-v1,
  last-attempt-unix-seconds: runtime-ipc-ticket-automation-optional-uint-v1,
  last-success-unix-seconds: runtime-ipc-ticket-automation-optional-uint-v1,
  next-attempt-unix-seconds: runtime-ipc-ticket-automation-optional-uint-v1,
  consecutive-failures: 0..4294967295,
  publication-generation: runtime-ipc-ticket-automation-optional-uint-v1,
  expires-at-unix-seconds: runtime-ipc-ticket-automation-optional-uint-v1,
  runtime-ipc-ticket-automation-last-result-v1
]

runtime-ipc-ticket-automation-policy-status-v1 = [
  profile-version,
  runtime-ipc-ticket-automation-configuration-v1,
  generation: uint,
  previous-policy-id: runtime-ipc-ticket-automation-optional-id-v1,
  policy-id: digest,
  configured-at-unix-seconds: uint,
  publish: runtime-ipc-ticket-automation-action-status-v1,
  refresh: runtime-ipc-ticket-automation-action-status-v1
]

runtime-ipc-ticket-automation-result-v1 =
  [ticket-automation-configured: 0,
   outcome: 0..1,
   observed-at-unix-seconds: uint,
   runtime-ipc-ticket-automation-network-v1,
   runtime-ipc-ticket-automation-policy-status-v1,
   restart-not-required: 0,
   foreground-runtime-only: 0,
   os-background-service-enabled: 0] /
  [ticket-automation-status: 1,
   observed-at-unix-seconds: uint,
   runtime-ipc-ticket-automation-network-v1,
   snapshot-id: digest,
   policies: [* runtime-ipc-ticket-automation-policy-status-v1],
   foreground-runtime-only: 0,
   os-background-service-enabled: 0,
   policy-count: 0..256] /
  [error: 2, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-ticket-automation-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-ticket-automation-result-v1
]

signed-runtime-ipc-ticket-automation-response-v1 = [
  profile-version,
  runtime-ipc-ticket-automation-response-content-v1,
  signature
]

kilogram-runtime-ipc-v1 =
  signed-runtime-ipc-descriptor-v1 /
  runtime-ipc-core-request-v1 /
  signed-runtime-ipc-core-response-v1 /
  runtime-ipc-read-request-v1 /
  signed-runtime-ipc-read-response-v1 /
  runtime-ipc-contact-request-v1 /
  signed-runtime-ipc-contact-response-v1 /
  runtime-ipc-directory-request-v1 /
  signed-runtime-ipc-directory-response-v1 /
  runtime-ipc-queue-request-v1 /
  signed-runtime-ipc-queue-response-v1 /
  runtime-ipc-outbox-request-v1 /
  signed-runtime-ipc-outbox-response-v1 /
  runtime-ipc-provider-request-v1 /
  signed-runtime-ipc-provider-response-v1 /
  runtime-ipc-mailbox-status-request-v1 /
  signed-runtime-ipc-mailbox-status-response-v1 /
  runtime-ipc-mailbox-mutation-request-v1 /
  signed-runtime-ipc-mailbox-mutation-response-v1 /
  runtime-ipc-publication-request-v1 /
  signed-runtime-ipc-publication-response-v1 /
  runtime-ipc-publication-network-request-v1 /
  signed-runtime-ipc-publication-network-response-v1 /
  runtime-ipc-publication-conflict-request-v1 /
  signed-runtime-ipc-publication-conflict-response-v1 /
  runtime-ipc-own-device-announcement-request-v1 /
  signed-runtime-ipc-own-device-announcement-response-v1 /
  runtime-ipc-own-device-discovery-request-v1 /
  signed-runtime-ipc-own-device-discovery-response-v1 /
  runtime-ipc-own-device-roster-request-v1 /
  signed-runtime-ipc-own-device-roster-response-v1 /
  runtime-ipc-recovery-plan-request-v1 /
  signed-runtime-ipc-recovery-plan-response-v1 /
  runtime-ipc-recovery-execution-request-v1 /
  signed-runtime-ipc-recovery-execution-response-v1 /
  runtime-ipc-ticket-automation-request-v1 /
  signed-runtime-ipc-ticket-automation-response-v1

; Kilogram deterministic-CBOR local runtime IPC core, read, contact, directory and queue model, M1.1.32.
; Only unsigned integers, definite byte strings and definite arrays are used.

profile-version = 1
digest = bytes .size 32
token = bytes .size 32
account-id = bytes .size 32
device-id = bytes .size 32
instance-id = bytes .size 32
request-id = bytes .size 32
signature = bytes .size 64

runtime-ipc-loopback-address-v1 =
  [ipv4: 0, bytes .size 4] /
  [ipv6: 1, bytes .size 16]

runtime-ipc-descriptor-content-v1 = [
  profile-version,
  runtime-ipc-loopback-address-v1,
  port: 1..65535,
  bearer-token: token,
  account-id,
  device-id,
  server-instance-id: instance-id,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint
]

signed-runtime-ipc-descriptor-v1 = [
  profile-version,
  runtime-ipc-descriptor-content-v1,
  signature
]

runtime-ipc-core-command-v1 =
  [ping: 0] /
  [wait-for-change: 1, after-revision: uint, timeout-milliseconds: 1..120000] /
  [shutdown: 2]

runtime-ipc-core-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-core-command-v1
]

runtime-ipc-core-result-v1 =
  [pong: 0, account-id, device-id] /
  [change-state: 1, revision: uint, changed: 0..1] /
  [shutdown-accepted: 2] /
  [error: 3, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-core-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-core-result-v1
]

signed-runtime-ipc-core-response-v1 = [
  profile-version,
  runtime-ipc-core-response-content-v1,
  signature
]

runtime-ipc-option-uint-v1 = [none: 0] / [some: 1, uint]
runtime-ipc-option-bytes-v1 = [none: 0] / [some: 1, bytes]

runtime-ipc-conversation-cursor-v1 = [
  conversation-label-utf8: bytes .size (1..4096),
  peer-account-id: account-id
]

runtime-ipc-conversation-cursor-option-v1 =
  [none: 0] /
  [some: 1, runtime-ipc-conversation-cursor-v1]

runtime-ipc-history-cursor-v1 = [
  snapshot-id: digest,
  before-index: uint
]

runtime-ipc-history-cursor-option-v1 =
  [none: 0] /
  [some: 1, runtime-ipc-history-cursor-v1]

runtime-ipc-read-command-v1 =
  [conversation-list-page: 0, runtime-ipc-conversation-cursor-option-v1, limit: 1..64] /
  [history-page: 1, conversation-label-utf8: bytes .size (1..4096), runtime-ipc-history-cursor-option-v1, limit: 1..100]

runtime-ipc-read-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-read-command-v1
]

runtime-ipc-route-policy-v1 = 0..2
runtime-ipc-endpoint-state-v1 = 0..2

runtime-ipc-endpoint-candidate-v1 = [
  peer-device-id: device-id,
  primary: 0..1,
  runtime-ipc-route-policy-v1,
  descriptor-path-utf8: bytes .size (1..4096),
  runtime-ipc-endpoint-state-v1,
  authority-revision: runtime-ipc-option-uint-v1,
  publication-channel-id-utf8: runtime-ipc-option-bytes-v1,
  observed-publication-generation: runtime-ipc-option-uint-v1,
  observed-at-unix-seconds: runtime-ipc-option-uint-v1,
  publication-conflict-generation: runtime-ipc-option-uint-v1,
  publication-conflict-proof-id-utf8: runtime-ipc-option-bytes-v1,
  publication-conflict-detected-at-unix-seconds: runtime-ipc-option-uint-v1,
  detail-utf8: bytes .size (1..4096)
]

runtime-ipc-message-preview-v1 = [
  event-id: digest,
  author-account-id: account-id,
  body-utf8: bytes .size (1..96),
  truncated: 0..1
]

runtime-ipc-message-preview-option-v1 =
  [none: 0] /
  [some: 1, runtime-ipc-message-preview-v1]

runtime-ipc-conversation-summary-v1 = [
  contact-id-utf8: bytes .size (1..4096),
  conversation-label-utf8: bytes .size (1..4096),
  conversation-id: digest,
  peer-account-id: account-id,
  peer-device-id: device-id,
  endpoint-candidate-count: 1..4,
  usable-endpoint-candidate-count: 0..4,
  stale-endpoint-candidate-count: 0..4,
  quarantined-endpoint-candidate-count: 0..4,
  endpoint-candidates: [1*4 runtime-ipc-endpoint-candidate-v1],
  runtime-ipc-route-policy-v1,
  message-count: uint,
  runtime-ipc-message-preview-option-v1
]

runtime-ipc-history-message-v1 = [
  event-id: digest,
  author-account-id: account-id,
  author-device-id: device-id,
  author-sequence: uint,
  body-utf8: bytes .size (1..196608)
]

runtime-ipc-history-page-v1 = [
  conversation-id: digest,
  snapshot-id: digest,
  total-messages: uint,
  messages: [* runtime-ipc-history-message-v1],
  runtime-ipc-history-cursor-option-v1
]

runtime-ipc-read-result-v1 =
  [conversation-list-page: 0, conversations: [* runtime-ipc-conversation-summary-v1], runtime-ipc-conversation-cursor-option-v1] /
  [history-page: 1, runtime-ipc-history-page-v1] /
  [error: 2, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-read-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-read-result-v1
]

signed-runtime-ipc-read-response-v1 = [
  profile-version,
  runtime-ipc-read-response-content-v1,
  signature
]

runtime-ipc-option-digest-v1 = [none: 0] / [some: 1, digest]

runtime-ipc-contact-command-v1 =
  [add-contact: 0, conversation-label-utf8: bytes .size (1..4096), expected-peer-account-id: account-id, peer-endpoint-descriptor-path-utf8: bytes .size (1..4096)] /
  [own-device-directory-status: 1]

runtime-ipc-contact-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-contact-command-v1
]

runtime-ipc-profile-convergence-v1 =
  current: 0 /
  required: 1

runtime-ipc-restart-recovery-v1 =
  authenticated-receipt-current: 0 /
  authenticated-receipt-recovered: 1 /
  launch-profile-recovered: 2

runtime-ipc-own-device-directory-status-v1 = [
  profile-version,
  account-id,
  device-id,
  state-directory-path-utf8: bytes .size (1..4096),
  authority-revision: 1..18446744073709551615,
  active-device-count: 1..32,
  applied-receipt-id: runtime-ipc-option-digest-v1,
  applied-receipt-generation: runtime-ipc-option-uint-v1,
  device-list-digest: digest,
  applied-device-list-file-utf8: bytes .size (1..4096),
  launch-device-list-file-utf8: bytes .size (1..4096),
  runtime-ipc-profile-convergence-v1,
  runtime-ipc-restart-recovery-v1
]

runtime-ipc-contact-result-v1 =
  [contact-added: 0, contact-id: digest, peer-account-id: account-id, peer-device-id: device-id, endpoint-candidate-count: 1..4, endpoint-candidate-added: 0..1, inserted: 0..1] /
  [own-device-directory-status: 1, runtime-ipc-own-device-directory-status-v1] /
  [error: 2, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-contact-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-contact-result-v1
]

signed-runtime-ipc-contact-response-v1 = [
  profile-version,
  runtime-ipc-contact-response-content-v1,
  signature
]

runtime-ipc-directory-command-v1 =
  [apply-own-device-directory: 0,
   device-list-file-utf8: bytes .size (1..4096),
   expected-current-authority-revision: 1..18446744073709551615,
   expected-current-device-list-digest: digest,
   candidate-signed-account-device-list-cbor: bytes .size (1..65536)]

runtime-ipc-directory-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-directory-command-v1
]

runtime-ipc-future-recipient-status-v1 =
  removed-devices-excluded-from-future-recipient-sets: 0

runtime-ipc-preexisting-recipient-status-v1 =
  immutable-cannot-be-remotely-rewritten-or-erased: 0

runtime-ipc-history-availability-status-v1 =
  existing-copies-remain-readable: 0

runtime-ipc-device-directory-applied-v1 = [
  profile-version,
  account-id,
  device-id,
  previous-authority-revision: 1..18446744073709551615,
  authority-revision: 1..18446744073709551615,
  previous-device-list-digest: digest,
  device-list-digest: digest,
  active-device-count: 1..32,
  removed-device-ids: [*32 device-id],
  ratchet-session-records-retired: uint,
  prekey-observations-retired: uint,
  pending-unmaterialized-messages: uint,
  pending-materialized-messages: uint,
  ticket-published: 0..1,
  launch-profile-update-required: 0..1,
  runtime-ipc-future-recipient-status-v1,
  runtime-ipc-preexisting-recipient-status-v1,
  runtime-ipc-history-availability-status-v1,
  runtime-ipc-own-device-directory-status-v1
]

runtime-ipc-directory-result-v1 =
  [own-device-directory-applied: 0, runtime-ipc-device-directory-applied-v1] /
  [error: 1, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-directory-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-directory-result-v1
]

signed-runtime-ipc-directory-response-v1 = [
  profile-version,
  runtime-ipc-directory-response-content-v1,
  signature
]

runtime-ipc-queue-command-v1 =
  [queue-message: 0,
   conversation-label-utf8: bytes .size (1..4096),
   peer-account-id: account-id,
   message-utf8: bytes .size (1..65536)]

runtime-ipc-queue-request-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  bearer-token: token,
  issued-at-unix-seconds: uint,
  expires-at-unix-seconds: uint,
  runtime-ipc-queue-command-v1
]

runtime-ipc-queue-result-v1 =
  [message-queued: 0,
   queue-id: digest,
   contact-id: digest,
   conversation-id: digest,
   peer-account-id: account-id,
   inserted: 0..1] /
  [error: 1, error-code: 1..65535, message-utf8: bytes .size (1..4096)]

runtime-ipc-queue-response-content-v1 = [
  profile-version,
  descriptor-id: digest,
  request-id,
  request-digest: digest,
  responder-device-id: device-id,
  runtime-ipc-queue-result-v1
]

signed-runtime-ipc-queue-response-v1 = [
  profile-version,
  runtime-ipc-queue-response-content-v1,
  signature
]

kilogram-runtime-ipc-v1 =
  signed-runtime-ipc-descriptor-v1 /
  runtime-ipc-core-request-v1 /
  signed-runtime-ipc-core-response-v1 /
  runtime-ipc-read-request-v1 /
  signed-runtime-ipc-read-response-v1 /
  runtime-ipc-contact-request-v1 /
  signed-runtime-ipc-contact-response-v1 /
  runtime-ipc-directory-request-v1 /
  signed-runtime-ipc-directory-response-v1 /
  runtime-ipc-queue-request-v1 /
  signed-runtime-ipc-queue-response-v1

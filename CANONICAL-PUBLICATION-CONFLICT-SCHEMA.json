  "cddl": {
    "standard": "RFC 8610",
    "path": "CANONICAL-PUBLICATION-CONFLICT.cddl",
    "root_rule": "kilogram-publication-conflict-evidence-v1"
  },
  "source_compatibility": {
    "current_runtime_encoding": "postcard-base64url-uri",
    "current_runtime_changed": false,
    "candidate_protocol_identifier": "unassigned"
  },
  "coverage": {

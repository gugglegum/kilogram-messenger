  "rust_bindings": [
    {
      "path": "crates/kilogram-protocol/src/canonical_prekey_selection_v1.rs",
      "symbol": "CANONICAL_PREKEY_SELECTION_DOMAIN",
      "rust_type": "bytes",
      "value": "kilogram:prekey-selection:cbor-v1\\0"
    }
  ],
  "objects": [
    {
      "id": "prekey-selection-input-v1",
      "kind": "digest-input",
      "array_length": 3

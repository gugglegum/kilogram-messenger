    {
      "id": "prekey-selection-transcript-v1",
      "kind": "derived-transcript",
      "array_length": 6
    }
  ],
  "derivation": {
    "pool_id": "blake3(prekey-pool-id-domain || signed-prekey-pool-v1-cbor)",
    "selection_input": "cbor([1, initiator-device-id, pool-id])",
    "selection_digest": "blake3(prekey-selection-domain || selection-input-cbor)",
    "digest_prefix": "first 8 digest bytes interpreted as unsigned big-endian u64",
    "selected_index": "digest-prefix modulo verified pool bundle count",
    "selected_sequence": "sequence of the bundle at selected-index"
  },
  "semantic_rules": [
    "the nested signed prekey pool is verified before selection",
    "the exact pool bytes determine the pool ID and therefore the selection",
    "all redundant digest, index and sequence fields must match recomputation",
    "the transcript is not proof that the initiator controls its Device key",
    "pool freshness is enforced by the caller and not ambient decoder time"
  ]
